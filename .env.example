# ==========================================
# RESIDENTHUB CONFIGURATION
# ==========================================

# Environment Mode: development | production
ENVIRONMENT="development"
JWT_SECRET="replace-with-a-random-secret-key-for-local-dev"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------
# DATABASE (PostgreSQL with pgvector)
# ------------------------------------------
# Local Docker or Free Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residenthub"

# ------------------------------------------
# STORAGE (Supabase Storage or Cloudflare R2)
# ------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
STORAGE_BUCKET="residenthub-receipts"

# ------------------------------------------
# AI & LLM ENGINE (Dual-Tier Pluggable)
# ------------------------------------------
# Options: 'ollama' (Local Dev/Test) or 'groq' (Production)
LLM_PROVIDER="ollama"

# [1] Local Ollama Settings (Zero Cost / Offline)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# [2] Production Free Groq Settings
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------
# TELEGRAM BOT (Notifications & Resident Q&A)
# ------------------------------------------
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
